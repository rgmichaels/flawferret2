DATABASE_URL="postgresql://USER:PASSWORD@HOST/flawferret2?sslmode=require"
API_HOST="0.0.0.0"
API_PORT="4000"
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
FERRET_RUNNER_ENABLE_CODEX="false"
FERRET_RUNNER_ENABLE_PR_CREATION="false"
FERRET_RUNNER_LOG_DIR=".flawferret-runs"
FERRET_RUNNER_LOCAL_TEST_TIMEOUT_MS="300000"
FERRET_RUNNER_VALIDATION_COMMAND=""
# Job worktrees live here, outside your checkout. Blank = ~/.flawferret/worktrees.
FERRET_RUNNER_WORKTREE_DIR=""
# Worktrees of BLOCKED/FAILED/CANCELED/closed-PR jobs are kept this long for debugging.
FERRET_RUNNER_WORKTREE_RETENTION_HOURS="24"
FERRET_RUNNER_WORKTREE_SWEEP_INTERVAL_MS="3600000"
# Global install fallback when a repository has no install command. Blank = pnpm
# install --frozen-lockfile if the worktree has pnpm-lock.yaml, otherwise skipped.
FERRET_RUNNER_INSTALL_COMMAND=""
FERRET_RUNNER_INSTALL_TIMEOUT_MS="300000"
# Every Nth worker-loop iteration skips the PR-lifecycle claim so queued jobs are
# never starved by a job parked in PR_CREATED. Lower = fresher queue pickup.
FERRET_RUNNER_QUEUED_CLAIM_FAIRNESS_N="3"
SLACK_WEBHOOK_URL=""
CODEX_COMMAND="codex"
CODEX_TIMEOUT_MS="1200000"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_SCENARIO_EXPLAIN_MODEL=""
OPENAI_DISCOVER_TESTS_MODEL=""
GITHUB_TOKEN=""
# Defaults to config/model-prompt-preface.txt when unset.
FF2_MODEL_PROMPT_PREFACE_PATH=""
# Optional direct override. Leave blank to use the configured file.
FF2_MODEL_PROMPT_PREFACE=""
WORKER_HEARTBEAT_INTERVAL_MS="60000"
WORKER_POLL_INTERVAL_MS="5000"
WORKER_SIMULATED_WORK_MS="10000"
WORKER_VERSION="0.1.0"
